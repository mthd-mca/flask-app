pipeline{
 agent any

 environment{
  img_name= "675711/flask-app"
  docker_cred = 'dockerhub'
}

stages{
  stage('checkout'){
    steps{
	git branch:'main',
	url:'https://github.com/mthd-mca/flask-app.git'
  }
 }

  stage('build docker'){
   steps{
	script{
	  docker_img=docker.build("${img_name}:latest")
	}
    }
  }

  stage('push docker'){
    steps{
	script{
	  docker.withRegistry('',docker_cred){
		docker_img.push('latest')
		}
	}	
     }
  }

  stage('kube depoly'){
     steps{
   sh '''
                kubectl delete deployment flask-app --ignore-not-found
                kubectl delete service flask-service --ignore-not-found

                kubectl create deployment flask-app \
                  --image=675711/flask-app:latest

                kubectl scale deployment flask-app --replicas=2

                kubectl expose deployment flask-app \
                  --name=flask-service \
                  --type=NodePort \
                  --port=5000 \
                  --target-port=5000
                '''	
    }
   }

   stage('verify'){
	steps{
	   sh 'kubectl get pods'
	   sh 'kubectl get services'
	 }
   }

} 

}
