pipeline {
    agent any

    environment {
        IMAGE_NAME = "675711/flask-app"
        DOCKERHUB_CREDENTIALS = 'dockerhub'
        DEPLOYMENT_NAME = "flask-app"
        SERVICE_NAME = "flask-service"
    }

    stages {

        stage('Clone from GitHub') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/mthd-mca/flask-app.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    dockerImage = docker.build("${IMAGE_NAME}:latest")
                }
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                script {
                    docker.withRegistry('', DOCKERHUB_CREDENTIALS) {
                        dockerImage.push('latest')
                    }
                }
            }
        }

       stage('Deploy') {
    steps {
        // 'k8s-credentials-id' is the ID of the Secret File or Kubeconfig stored in Jenkins
        withKubeConfig([credentialsId: 'k8s-credentials-id']) {
            sh 'kubectl delete deployment flask-app --ignore-not-found'
        }
    }
}

        stage('Verify Deployment') {
            steps {
                sh '''
                kubectl get deployments
                kubectl get pods
                kubectl get services
                '''
            }
        }
    }

    post {
        success {
            echo "Flask CI/CD Pipeline Executed Successfully on Kubernetes (No YAML)"
        }
        failure {
            echo "pipeline Failed"
        }
    }
}
